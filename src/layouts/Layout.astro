---
import { Font } from "astro:assets";
// import { ClientRouter } from "astro:transitions";

import { sanityClient } from "sanity:client";
import { LAYOUT_QUERY } from "~/queries/layout";
import type { Seo } from "sanity.types";

import Footer from "~/components/Footer.astro";
import Navbar from "~/components/Navbar.svelte";
import imageBuilder from "~/lib/imageBuilder";
import "../styles/global.css";

interface Props {
  title?: string;
  seo?: Seo;
}
const { title: givenTitle, seo: givenSeo } = Astro.props;

const result = await sanityClient.fetch(LAYOUT_QUERY);

const pageTitle = givenTitle
  ? `${givenTitle} - ${result?.siteName}`
  : result?.siteName;
const seo = {
  ...(result?.globalSeo || {}),
  ...(givenSeo || {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    {seo.description && <meta name="description" content={seo.description} />}
    {seo.noIndex && <meta name="robots" content="noindex" />}

    <meta property="og:title" content={givenTitle || result?.siteName} />
    <meta property="og:site_name" content={result?.siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.toString()} />
    {
      seo.description && (
        <meta name="og:description" content={seo.description} />
      )
    }
    {
      seo.image && (
        <meta
          property="og:image"
          content={imageBuilder.image(seo.image).url()}
        />
      )
    }

    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-heading" preload />
    <Font cssVariable="--font-serif" />
    <Font cssVariable="--font-cursive" />

    <!-- <ClientRouter /> -->

    <script
      is:inline
      src="https://analytics.ahrefs.com/analytics.js"
      data-key="To6byBCl2h9X7SYhdwJCiA"
      async></script>
  </head>
  <body>
    <Navbar
      client:load
      transition:persist
      logo={result?.navbar?.logo}
      links={(result?.navbar?.links || []).map(({ label, slug }) => ({
        label,
        slug,
      }))}
    />

    <slot />

    {result?.footer && <Footer data={result.footer} />}
  </body>
</html>
